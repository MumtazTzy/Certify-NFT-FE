###############################
# Line endings and scripts
###############################

# Always use LF for shell scripts so they run in Git Bash/Linux
*.sh text eol=lf

# Common text files normalized
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf


